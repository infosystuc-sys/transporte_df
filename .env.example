# Supabase — Project Settings > API en el dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta. NUNCA exponer al navegador ni usar en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — Project Settings > Database > Connection string (modo "Transaction pooler")
DATABASE_URL=

# Opcional: habilita el fallback de extracción de CPE con Claude cuando el
# PDF no tiene texto seleccionable ni QR legible. Sin esta variable, el
# sistema simplemente pide cargar esos casos a mano.
ANTHROPIC_API_KEY=
